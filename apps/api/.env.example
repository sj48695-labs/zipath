# 앱 부팅 시 Joi 스키마(src/config/env.validation.ts)로 검증됩니다.
# 필수 값이 없거나 형식이 틀리면 부팅이 즉시 중단됩니다.

# [필수] PostgreSQL 연결 URL (docker compose up -d 실행 후 사용)
DATABASE_URL=postgresql://zipath:zipath@localhost:5432/zipath

# [필수] 공공데이터포털 API 키
DATA_GO_KR_API_KEY=your_api_key_here

# 서버 포트 (기본값 4000)
PORT=4000

# 실행 환경: development | production | test (기본값 development)
NODE_ENV=development

# JWT 시크릿 (production 에서는 필수, dev 기본값 zipath-dev-secret)
JWT_SECRET=zipath-dev-secret

# OAuth / 결제 키는 production 에서만 필수입니다.
# (development 에서는 비워둬도 부팅됩니다)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
